API_NAME=Mirai Hit Studio API
API_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=sqlite:///mirai.db
ALLOWED_ORIGINS=http://localhost:4173

BACKUP_FOLDER=backups
BACKUP_KEEP_DAYS=7

RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
PUBLIC_API_URL=http://localhost:8000
PUBLIC_FRONTEND_URL=http://localhost:4173

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TIMEOUT_SECONDS=10

# AI core: provider disabled keeps sessions, local knowledge, handoff and Inbox available.
AI_ENABLED=false
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=8
AI_MAX_OUTPUT_TOKENS=1200
AI_SESSION_HOURS=24

# AI email channel: disabled until an inbound address and signed Resend webhook are configured.
AI_EMAIL_ENABLED=false
COMMERCIAL_PIPELINE_V2_ENABLED=false
AI_EMAIL_FROM=
AI_EMAIL_INBOUND_ADDRESS=
AI_EMAIL_MAX_BODY_CHARS=8000
RESEND_WEBHOOK_SECRET=

# Production-only operational paths must be absolute and persistent.
PROPOSTA_STORAGE_BACKEND=local
PROPOSTA_PDF_DIR=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=propostas-pdf
PORTFOLIO_AUDIO_STORAGE_BUCKET=portfolio-audio
PORTFOLIO_AUDIO_MAX_BYTES=31457280
PRODUCAO_STORAGE_BUCKET=producao-arquivos

# Multi-provider storage core. These settings do not change active uploads until
# the relevant 3.8B-F integration phase wires each flow to the registry.
PUBLIC_IMAGE_STORAGE_BACKEND=cloudinary
PORTFOLIO_AUDIO_STORAGE_BACKEND=supabase
PRODUCTION_TEMP_STORAGE_BACKEND=r2
PRODUCTION_FINAL_STORAGE_BACKEND=r2
PROPOSAL_DOCUMENT_STORAGE_BACKEND=legacy

# Public images (server-side credentials only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Private Production objects. Keep both buckets private.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_TEMP_BUCKET=
R2_FINAL_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
R2_PRESIGN_MAX_SECONDS=900
RATE_LIMIT_DB=
