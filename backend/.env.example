# AI email channel: disabled until an inbound address and signed Resend webhook are configured.
AI_EMAIL_ENABLED=false
AI_EMAIL_FROM=
AI_EMAIL_INBOUND_ADDRESS=
AI_EMAIL_MAX_BODY_CHARS=8000
RESEND_WEBHOOK_SECRET=
